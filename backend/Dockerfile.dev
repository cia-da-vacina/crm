FROM golang:1.26-alpine

WORKDIR /app

# Install build tools
RUN apk add --no-cache git make curl

# Install Air for hot reload
RUN go install github.com/air-verse/air@latest

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

EXPOSE 8080

# Run with hot reload
ENTRYPOINT ["air", "-c", ".air.toml"]
