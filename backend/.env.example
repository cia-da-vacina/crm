# Environment
ENVIRONMENT=dev

# App
API_NAME=crm-api
API_PORT=8080
API_DOMAIN=localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000

# JWT - Token (ver docs/decisions.md: access 15min, refresh 7 dias)
JWT_SECRET=change-me-in-dev-only-please
TOKEN_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=168h

# Password hashing (argon2id)
PASSWORD_HASH_MEMORY_COST=65536
PASSWORD_HASH_TIME_COST=4
PASSWORD_HASH_THREADS=4
PASSWORD_HASH_PEPPER=change-me-in-dev-only-please

# Database
DATABASE_URL=postgres://crm:crm2026@postgres:5432/crm?sslmode=disable

# Criptografia de tokens de canal Meta em repouso (AES-256, hex de 32 bytes).
# Gerar com: openssl rand -hex 32
APP_ENCRYPTION_KEY=change-me-generate-32-bytes-hex-in-dev

# Meta (WhatsApp/Instagram/Facebook) — segredos de app, não de canal (um só
# pro ambiente inteiro; os tokens por canal ficam cifrados no banco via
# PUT /settings/meta). META_APP_SECRET assina o HMAC dos webhooks;
# META_WEBHOOK_VERIFY_TOKEN é conferido no handshake GET /webhooks/meta/*.
META_APP_SECRET=change-me-in-dev-only-please
META_WEBHOOK_VERIFY_TOKEN=change-me-in-dev-only-please

# OpenAI (triagem por IA, fase 7 — docs/decisions.md D-02). Sem chave, o
# backend usa um MockClient (loga, não chama rede) — troca pro client real
# sozinha assim que a chave existir, nenhum código muda.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
