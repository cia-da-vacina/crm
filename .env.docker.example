# Copy to `.env.docker` (gitignored) and adjust as needed:
#   cp .env.docker.example .env.docker

FRONTEND_PORT=3000

# Demo without Go API (default)
USE_MOCKS=true
COOKIE_SECURE=false

# When USE_MOCKS=false, point at the real API:
# USE_MOCKS=false
# API_URL=http://backend:8080/api/v1
# or host machine:
# API_URL=http://host.docker.internal:8080/api/v1

# BACKEND_PORT=8080
# JWT_SECRET=change-me-in-production
