# Copy to `.env.docker` (gitignored) and adjust as needed:
#   cp .env.docker.example .env.docker

# Host port → container always listens on :3000 (same pattern as NeoWeb prod 3500:3000).
# VPS already uses 3000 for another app → default 3510 for Cloudflare Tunnel.
FRONTEND_PORT=3510

# Demo without Go API (default)
USE_MOCKS=true
COOKIE_SECURE=false

# When exposing via HTTPS (Cloudflare Tunnel), prefer:
# COOKIE_SECURE=true

# When USE_MOCKS=false, point at the real API:
# USE_MOCKS=false
# API_URL=http://backend:8080/api/v1
# or host machine:
# API_URL=http://host.docker.internal:8080/api/v1

# BACKEND_PORT=8080
# JWT_SECRET=change-me-in-production
